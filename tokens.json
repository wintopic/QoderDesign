  "effects": {
    "windowWash": {
      "light": "none",
      "forest-light": "linear-gradient(#ffffff80, #ffffff80)",
      "bee-light": "linear-gradient(180deg, #e6e6b6 0%, #c4d0da 100%)",
      "mint-light": "linear-gradient(#c9e8dd8a, #c9e8dd8a)",
      "light-parchment": "linear-gradient(#ffffffbd, #ffffffbd)",
      "forest-dark": "linear-gradient(#242624, #242624)",
      "bee-dark": "linear-gradient(#10110e, #10110e)",
      "mint-dark": "linear-gradient(#112820, #112820)",
      "parchment-dark": "linear-gradient(#292017, #292017)"
    },
    "noise": {
      "image": "SVG feTurbulence (kit replacement for Qoder noise webp)",
      "size": "50px",
      "opacity": {
        "light": 0,
        "forest-light": 0.018,
        "forest-dark": 0.035,
        "other": 0
      },
      "sourceOpacity": {
        "forest-light": 0.2,
        "forest-dark": 1
      }
    },
    "glass": {
      "gradient": "linear-gradient(180deg, color-mix(in srgb, var(--q-bg-base) 64%, transparent) 0%, color-mix(in srgb, var(--q-bg-elevated) 42%, transparent) 100%)",
      "blur": "blur(40px) saturate(150%)",
      "shadow": "0 8px 18px -8px var(--q-shadow-color-2), 0 18px 42px -20px var(--q-shadow-color-4), inset 0 1px 0 color-mix(in srgb, var(--q-bg-base) 72%, transparent)"
    },
    "scrollFade": {
      "size": "min(12%, 40px)",
      "implementation": "js-toggled mask"
    },
    "pointerField": {
      "cellSize": 24,
      "radius": 144,
      "fadeDuration": 450,
      "sourceRadius": 72,
      "sourceFadeDuration": 720
    },
    "themeTransition": {
      "duration": "160ms",
      "easing": "ease-out",
      "api": "View Transitions"
    },
    "textGradient": "linear-gradient(100deg, var(--q-text) 20%, var(--q-primary) 100%)",
    "disableAttribute": "data-visual-effects=\"off\""
  },
  "components": {
    "switch": {
      "element": "button",
      "type": "button",
      "role": "switch",
      "stateAttribute": "aria-checked",
      "cornerShape": "round",
      "borderWidth": 1,
      "structure": [
        "button.q-switch",
        "span[data-switch-thumb]",
        "span[data-switch-visual]"
      ],
      "sizes": {
        "md": {
          "trackWidth": 32,
          "trackHeight": 20,
          "thumbSize": 16,
          "hoverWidth": 18,
          "attractWidth": 24,
          "checkedTranslateX": 13,
          "uncheckedTranslateX": 1
        },
        "sm": {
          "trackWidth": 28,
          "trackHeight": 16,
          "thumbSize": 12,
          "hoverWidth": 14,
          "attractWidth": 20,
          "checkedTranslateX": 13,
          "uncheckedTranslateX": 1
        }
      },
      "motion": {
        "trackDurationMs": 120,
        "trackEasing": "ease-out",
        "translateDurationMs": 150,
        "translateEasing": "cubic-bezier(0.4,0,0.2,1)",
        "visualDurationMs": 200,
        "hoverDurationMs": 150,
        "clickDurationMs": 150,
        "clickTranslateDelayMs": 60,
        "clickTranslateDurationMs": 90,
        "widthKeyframes": [
          {
            "at": "0%",
            "width": "hoverWidth",
            "easing": "cubic-bezier(.2,.8,.2,1)"
          },
          {
            "at": "33.333%",
            "width": "attractWidth",
            "easing": "linear"
          },
          {
            "at": "40%",
            "width": "attractWidth",
            "easing": "cubic-bezier(.4,0,.2,1)"
          },
          {
            "at": "100%",
            "width": "thumbSize"
          }
        ],
        "hoverMedia": "(hover: hover) and (pointer: fine)",
        "disabledOpacity": 0.5,
        "reducedMotion": "no animation or transition",
        "pointerClick": "event.detail > 0 sets on/off attraction; pointerenter resets motion",
        "keyboardClick": "event.detail == 0 toggles state without attraction"
      },
      "tokens": {
        "on": "primary",
        "off": "switch-off-bg",
        "offBorder": "switch-off-border",
        "visual": "text-on-primary",
        "shadow": "shadow-color-4",
        "focusBorder": "primary-border"
      }
    },
    "checkbox": {
      "sizes": {
        "md": {
          "size": 16,
          "radius": 4,
          "indicatorSize": 10
        },
        "lg": {
          "size": 20,
          "radius": 6,
          "indicatorSize": 12
        }
      },
      "easing": "cubic-bezier(0.22,1,0.36,1)",
      "checkDurationMs": 200,
      "uncheckDurationMs": 100,
      "disabledUncheckedBackground": "fill-secondary",
      "disabledCheckedOpacity": 0.5
    },
    "radio": {
      "size": 16,
      "indicatorSize": 8,
      "border": "border",
      "checkedBackground": "text",
      "indicatorBackground": "bg-base"
    },
    "slider": {
      "orientation": "horizontal",
      "thumbs": 1,
      "sizes": {
        "md": {
          "trackHeight": 8,
          "thumbSize": 20,
          "thumbBorder": 2
        },
        "sm": {
          "trackHeight": 4,
          "thumbSize": 12,
          "thumbBorder": 1
        }
      },
      "rangeBackground": "primary",
      "trackBackground": "fill-secondary",
      "thumbBackground": "bg-base",
      "thumbCenterFormula": "thumbSize/2 + (trackWidth - thumbSize) * (value - min)/(max - min)",
      "event": "q:slider (user input only)"
    }
  }
}
